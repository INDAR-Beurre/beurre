{
  "name": "beurre",
  "version": "1.0.0",
  "description": "🧈 Beurre — A buttery-smooth, minimalist agentic CLI harness integrated with Model Aggregator & Relay",
  "main": "src/index.ts",
  "bin": {
    "beurre": "./bin/beurre"
  },
  "files": [
    "bin",
    "src",
    "package.json",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/INDAR-Beurre/beurre.git"
  },
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "link": "mkdir -p ~/.bun/bin ~/.local/bin && ln -sf $(pwd)/bin/beurre ~/.bun/bin/beurre && ln -sf $(pwd)/bin/beurre ~/.local/bin/beurre"
  },
  "dependencies": {
    "@oh-my-pi/pi-tui": "18.6.0"
  },
  "keywords": [
    "agent",
    "cli",
    "butter",
    "beurre",
    "relay",
    "model-aggregator",
    "autonomous",
    "loop"
  ],
  "author": "alex",
  "license": "MIT"
}
